{
  "name": "@johnhenry/sigil",
  "version": "0.0.0",
  "description": "Deterministic SVG/PNG identicons generated from any string.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./graphic": {
      "types": "./graphic.d.ts",
      "default": "./src/graphic.js"
    }
  },
  "files": [
    "src/",
    "index.d.ts",
    "graphic.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "examples": "for f in examples/0*.mjs; do echo \"== $f ==\" && node \"$f\" || exit 1; done",
    "example:01": "node examples/01-svg-from-any-string.mjs",
    "example:02": "node examples/02-png-data-uri.mjs",
    "example:03": "node examples/03-custom-colors-and-padding.mjs",
    "example:04": "node examples/04-new-output-format.mjs"
  },
  "keywords": [
    "identicon",
    "svg",
    "png",
    "avatar",
    "hash"
  ],
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT AND BSD-2-Clause",
  "homepage": "https://opensource.johnhenry.me/sigil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/sigil.git"
  },
  "bugs": "https://github.com/johnhenry/sigil/issues",
  "engines": {
    "node": ">=26.0.0"
  }
}
